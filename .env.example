# Copie para .env. Nunca coloque valores reais em arquivos versionados.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Obrigatório em produção. Sem isto o servidor usa o banco embutido, que não serve para produção.
DATABASE_URL=postgres://ritmo:SENHA@HOST:5432/ritmo
