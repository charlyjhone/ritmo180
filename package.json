{
  "name": "ritmo180",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma de treino de tempo e leitura para o ENEM, multiescola, com motor TRI próprio.",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:api": "node --watch apps/api/src/main.ts",
    "dev:web": "npm run dev -w @ritmo/web",
    "build": "npm run build -w @ritmo/web",
    "start": "node apps/api/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "db:seed": "node apps/api/src/cli/seed.ts",
    "db:calibrate": "node apps/api/src/cli/calibrate.ts",
    "ingest": "node apps/api/src/cli/ingest.ts",
    "content:liberar": "node apps/api/src/cli/release.ts",
    "content:completar": "node apps/api/src/cli/complete.ts",
    "conta:admin": "node apps/api/src/cli/account.ts admin",
    "conta:senha": "node apps/api/src/cli/account.ts senha",
    "conta:coordenacao": "node apps/api/src/cli/account.ts coordenacao",
    "turma": "sh scripts/abrir-para-turma.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
